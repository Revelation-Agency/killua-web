# Copy to .env for local work. Set real values in Vercel project settings, never in git.

# Server (api/lead.js)
KILLUA_LEAD_WEBHOOK_URL=        # Lane 2's n8n "Killua - Lead Intake (all sources)" webhook
KILLUA_LEAD_WEBHOOK_SECRET=     # optional; body HMAC-SHA256 sent as X-Killua-Signature
META_CAPI_TOKEN=                # optional; Meta Conversions API
META_TEST_EVENT_CODE=           # optional; Meta Events Manager test code
META_GRAPH_VERSION=v23.0
TIKTOK_EVENTS_TOKEN=            # optional; TikTok Events API
TIKTOK_TEST_EVENT_CODE=         # optional

# Browser (baked in at build time; empty = tag never loads)
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_GA4_ID=                  # G-XXXXXXX
PUBLIC_GOOGLE_ADS_ID=           # AW-XXXXXXX
PUBLIC_GOOGLE_ADS_LEAD_LABEL=   # conversion label for the lead action
PUBLIC_GOOGLE_MAPS_KEY=         # optional; street autocomplete (Places API New), referrer-restricted

# ---------------------------------------------------------------------------
# Dashboard (app.killuahome.com / dashboard). Full steps: docs/dashboard-setup.md
# Names only here; set real values in Vercel project settings, never in git.
# ---------------------------------------------------------------------------

# Login and sessions
DASH_USERS=                     # JSON array from: node scripts/dash-user.mjs <email> <name> <admin|owner|team>
DASH_SESSION_SECRET=            # 32+ random characters; signs the login cookie
DASH_INGEST_KEY=                # 24+ random characters; agents send it as "Authorization: Bearer ..."
CRON_SECRET=                    # random; Vercel sends it to the twice-a-day refresh

# Storage (added automatically when the private Blob store "killua-dashboard-data" is connected)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# DASH_STORE_SALT=              # optional; defaults to DASH_SESSION_SECRET

# GoHighLevel (private integration token)
GHL_TOKEN=
GHL_LOCATION_ID=                # Killua location: Ygk0sop4wB42XtqIEr1Q
# GHL_ROBIN_CALENDAR_ID=NZdC26OLQtOAc8iLipZG        "Robin Appointments" (default)
# GHL_EXCLUDE_CALENDAR_IDS=2tn3NQUMCfrluZO4jABH     Blaine's personal calendar (default; never read)
# General Sales calendar: P4WrbsVZwNtQ4c14NcKk (counted automatically)

# Meta ads (system-user token with ads_read)
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=             # VIP-Taj: act_400793053430148 (business portfolio 393582507484536)
META_PAGE_ID=                   # optional: Facebook Page id, for the social calendar (needs pages_read_engagement)
# META_GRAPH_VERSION=v23.0      (already listed above)

# Google (service account) for Search Console and the Google Ads sheet
GOOGLE_SA_JSON=                 # the whole service-account key file as JSON text
GSC_SITE_URL=                   # exactly as in Search Console, e.g. https://killuahome.com/ or sc-domain:killuahome.com
GOOGLE_ADS_SHEET_ID=            # the Sheet the Google Ads Script writes to
# GOOGLE_ADS_SHEET_TAB=Daily
