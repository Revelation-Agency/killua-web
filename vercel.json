{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.killuahome.com" }],
      "destination": "/api/dash?r=_page&p="
    },
    { "source": "/dashboard", "destination": "/api/dash?r=_page&p=" },
    { "source": "/dashboard/:path*", "destination": "/api/dash?r=_page&p=:path*" },
    { "source": "/api/dash/:path+", "destination": "/api/dash?r=:path*" }
  ],
  "functions": {
    "api/dash.js": {
      "maxDuration": 300,
      "includeFiles": "dashboard-app/**"
    }
  },
  "crons": [
    { "path": "/api/dash/cron", "schedule": "0 14 * * *" }
  ]
}
