---
import { consentText, type Brand } from '../data/company';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;

// Canonical consent sentence stored alongside the submission. Kept in the data
// module so the recorded text and the rendered label can never drift apart.
const consentSentence = consentText(brand);
---

<form class="form-card" id="optin-form" method="post" action="#">
  <p class="form-status" id="optin-status" role="alert" aria-live="polite" hidden></p>

  <div class="field">
    <label for="first_name">
      First name <span class="req" aria-hidden="true">(required)</span>
    </label>
    <input
      type="text"
      id="first_name"
      name="first_name"
      autocomplete="given-name"
      required
    />
  </div>

  <div class="field">
    <label for="last_name">
      Last name <span class="req" aria-hidden="true">(required)</span>
    </label>
    <input
      type="text"
      id="last_name"
      name="last_name"
      autocomplete="family-name"
      required
    />
  </div>

  <div class="field">
    <label for="phone">
      Mobile phone number <span class="req" aria-hidden="true">(required)</span>
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      inputmode="tel"
      autocomplete="tel"
      minlength="10"
      aria-describedby="phone-hint"
      required
    />
    <span class="field-hint" id="phone-hint">
      Ten digit United States mobile number. This is the number that will receive
      the text messages.
    </span>
  </div>

  <div class="field">
    <label for="email">Email address (optional)</label>
    <input type="email" id="email" name="email" autocomplete="email" />
  </div>

  <div class="consent">
    <div class="consent-row">
      <input type="checkbox" id="consent" name="consent" value="yes" required />
      <label for="consent">
        {
          'By checking this box, I give my express written consent to receive text messages from '
        }
        <strong>{brand.name}</strong>
        {
          ' at the mobile number provided, including messages sent by automated technology, about ' +
            brand.messagePurpose +
            '. Message frequency varies. Message and data rates may apply. Reply STOP to unsubscribe or HELP for help. '
        }
        <strong>Consent is not a condition of purchase.</strong>
        {' See our '}
        <a href={`/${brand.slug}/privacy/`}>Privacy Policy</a>
        {' and '}
        <a href={`/${brand.slug}/terms/`}>Terms of Service</a>{'.'}
      </label>
    </div>
    <p class="consent-required">
      This checkbox is required. The form cannot be submitted until it is checked.
    </p>
  </div>

  <button class="button" type="submit" id="optin-submit">
    Sign up for text messages
  </button>
</form>

<div
  class="success-panel"
  id="optin-success"
  role="status"
  tabindex="-1"
  hidden
>
  <h3>You are signed up</h3>
  <p>
    Thank you. We have recorded your consent to receive text messages from
    {brand.name} at the number you provided.
  </p>
  <p>
    Reply STOP to any message to stop receiving text messages. Reply HELP for
    help.
  </p>
</div>

<script
  is:inline
  define:vars={{
    endpoint: brand.optInEndpoint,
    brandName: brand.name,
    programName: brand.programName,
    brandPhone: brand.phone,
    consentSentence: consentSentence,
  }}
>
  (function () {
    var form = document.getElementById('optin-form');
    if (!form) {
      return;
    }

    var statusEl = document.getElementById('optin-status');
    var successEl = document.getElementById('optin-success');
    var consentEl = document.getElementById('consent');
    var submitEl = document.getElementById('optin-submit');

    function setStatus(message) {
      statusEl.textContent = message;
      statusEl.hidden = message === '';
    }

    function showSuccess() {
      form.hidden = true;
      successEl.hidden = false;
      successEl.focus();
    }

    function value(data, key) {
      var raw = data.get(key);
      return raw === null ? '' : String(raw).trim();
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      setStatus('');

      if (!consentEl.checked) {
        setStatus(
          'You must check the consent box before this form can be submitted.'
        );
        consentEl.focus();
        return;
      }

      var data = new FormData(form);
      var payload = {
        program: programName,
        brand: brandName,
        firstName: value(data, 'first_name'),
        lastName: value(data, 'last_name'),
        phone: value(data, 'phone'),
        email: value(data, 'email'),
        consent: true,
        consentText: consentSentence,
        consentTimestampUtc: new Date().toISOString(),
        consentPageUrl: window.location.href,
      };

      if (!endpoint) {
        console.info(
          'Killua opt-in payload. No endpoint is configured, so nothing was sent.',
          payload
        );
        showSuccess();
        return;
      }

      submitEl.disabled = true;
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Request failed with status ' + response.status);
          }
          showSuccess();
        })
        .catch(function () {
          submitEl.disabled = false;
          setStatus(
            'We could not submit the form just now. Please call ' +
              brandPhone +
              ' and we will sign you up.'
          );
        });
    });
  })();
</script>
