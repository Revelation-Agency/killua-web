---
import { site } from '../../data/site';
const icon = {
  badge: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.4 3.1 8.2 7.5 9.5 4.4-1.3 7.5-5.1 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="m8.8 12 2.2 2.2 4.3-4.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.9"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.9"/></svg>',
  roof: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12 12 4l9 8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10.5h8M7 13.5h10" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M5 12v8h14v-8" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg>',
};
---

<section class="trust" aria-label="Why you can check us">
  <div class="shell">
    <ul>
      <li>
        <span class="tick"><Fragment set:html={icon.badge} /></span>
        <span><strong>Licensed contractor, {site.license}</strong><a href={site.licenseUrl} target="_blank" rel="noopener">Look it up on the CSLB site</a></span>
      </li>
      <li>
        <span class="tick"><Fragment set:html={icon.pin} /></span>
        <span><strong>Office in Fresno</strong><a href={site.mapUrl} target="_blank" rel="noopener">{site.street}</a></span>
      </li>
      <li>
        <span class="tick"><Fragment set:html={icon.roof} /></span>
        <span><strong>Roofing and solar, one company</strong>No finger-pointing between a roofer and a solar installer.</span>
      </li>
    </ul>
  </div>
</section>
