---
import Site from '../layouts/Site.astro';
import Photo from '../components/site/Photo.astro';
import Trust from '../components/site/Trust.astro';
import Faq from '../components/site/Faq.astro';
import QuoteSection from '../components/site/QuoteSection.astro';
import { cities, site, taxCreditFaq } from '../data/site';
const arrow = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6"/></svg>';
const offerings = [
  { n:'01', title:'Solar, designed around you.', label:'Solar installation', body:'Turn the Central Valley sun into power for the home you actually live in.', image:'solar-home', href:'/solar-installation/', tag:'MAKE YOUR OWN POWER' },
  { n:'02', title:'Save the sun for later.', label:'Battery storage', body:'Store daytime energy for evening use and the essentials you want backed up.', image:'battery-garage', href:'/battery-storage/', tag:'KEEP IT FOR TONIGHT' },
  { n:'03', title:'A better roof above it all.', label:'Roofing', body:'Inspections, repairs and replacements. The foundation of a lasting solar system.', image:'roof-install', href:'/roof-replacement/', tag:'PROTECT WHAT MATTERS' },
  { n:'04', title:'Wake up ready to go.', label:'EV charging', body:'A dedicated home charger, installed around your car, panel and daily routine.', image:'ev-charger', href:'/ev-chargers/', tag:'BRING CHARGING HOME' },
];
const faqs = [
 {q:'Where should I start: solar, a battery, or the roof?',a:'Start with the home you have. We look at your energy use, roof condition and goals, then recommend what makes sense to do first. You can request a single service or discuss the whole picture.'},
 {q:'Can you work on solar another company installed?',a:'Yes. We diagnose and repair existing systems, including systems whose original installer has closed. We check the electrical system and the roof attachments.'},
 {q:'Do you serve commercial properties too?',a:'Yes. Killua Energy works with residential and commercial properties. Call our Fresno office to discuss the building and scope.'},
 taxCreditFaq,
 {q:'What happens after I request an estimate?',a:'Our Fresno office follows up using the details you provide. We discuss the project, answer your questions and arrange the next step. Your estimate is based on your home, not a generic savings promise.'},
];
---
<Site title="Killua Energy | Solar, Roofing & Home Energy in Fresno" description="Your home, fully powered. Solar, battery storage, roofing, solar repair and EV chargers from Killua Energy in Fresno and the Central Valley. CSLB #1096633." darkHeader>
  <section class="cinema-hero" aria-labelledby="hero-title">
    <div class="cinema-image" data-parallax><Photo name="hero-twilight" alt="Illustrative California home with rooftop solar and warmly lit windows at twilight" priority sizes="100vw" widths={[480,768,1200,1672]} quality={70} /></div>
    <div class="cinema-shade"></div>
    <div class="shell cinema-content">
      <p class="eyebrow hero-eyebrow"><span class="live-dot"></span> FRESNO ROOTS. CENTRAL VALLEY REACH.</p>
      <h1 id="hero-title">Your home.<br /><span>Fully powered.</span></h1>
      <p class="cinema-lede">Solar. Storage. Roofing. One local team.<br />Built for the way you live, from the roof down.</p>
      <div class="cinema-actions"><a class="btn btn-red" href="#quote">Let’s talk about your home <Fragment set:html={arrow}/></a><a class="text-link" href="#services">Explore our services <span>↘</span></a></div>
    </div>
    <div class="shell cinema-bottom"><div><span class="tiny-label">LOCAL EXPERTISE</span><span>Solar + roofing, together.</span></div><a href="#intro" class="scroll-cue" aria-label="Explore the website"><span>SCROLL TO EXPLORE</span><span class="scroll-ring">↓</span></a><div class="hero-license"><span class="tiny-label">CALIFORNIA CONTRACTOR</span><a href={site.licenseUrl} target="_blank" rel="noopener">{site.license} ↗</a></div></div>
  </section>
  <Trust />
  <section class="section intro-section" id="intro">
    <div class="shell intro-grid"><div><p class="eyebrow">01 / THE WHOLE HOME</p><h2 data-split>Good energy starts<br />with a better plan.</h2></div><div class="intro-copy" data-reveal><p>Your roof. Your power. Your next move.</p><p>They work better when someone sees the whole picture. From the roof to the charger in your garage, we help every part work together.</p><a class="line-link" href="/about/">Meet Killua Energy <Fragment set:html={arrow}/></a></div></div>
  </section>
  <section class="section service-showcase" id="services">
    <div class="shell"><div class="editorial-head"><div><p class="eyebrow">02 / BUILT AROUND YOUR HOME</p><h2 data-split>More possibility.<br />Under one roof.</h2></div><p>Start with what you need today.<br />Make room for what comes next.</p></div>
      <div class="photo-services">{offerings.map((s)=><a class="photo-service" href={s.href} data-reveal><div class="service-image"><Photo name={s.image} alt={`${s.label} concept for a California home`} sizes="(min-width: 64rem) 46vw, 100vw"/></div><div class="service-image-shade"></div><span class="service-number">{s.n} / {s.label}</span><div class="photo-service-copy"><span class="tiny-label">{s.tag}</span><h3>{s.title}</h3><p>{s.body}</p><span class="service-arrow"><Fragment set:html={arrow}/></span></div></a>)}</div>
      <div class="service-repair-link"><span>Already have solar? Let’s keep it working.</span><a class="line-link" href="/solar-repair/">Explore solar repair & maintenance <Fragment set:html={arrow}/></a></div>
    </div>
  </section>
  <section class="energy-story section" aria-labelledby="energy-title">
    <div class="shell"><div class="editorial-head"><div><p class="eyebrow">03 / A DIFFERENT KIND OF POWER COUPLE</p><h2 id="energy-title" data-split>The sun clocks out.<br />Your energy doesn’t have to.</h2></div><p>Solar makes it. A battery saves it.<br />Explore how they work through the day.</p></div>
      <div class="energy-explorer" data-energy data-phase="day">
        <div class="energy-visual"><Photo name="solar-home" alt="Illustrative solar home used to explain daytime generation and evening storage" sizes="(min-width: 64rem) 65vw, 100vw"/><div class="energy-tint"></div><div class="energy-tag"><span class="live-dot"></span><span data-energy-tag>Solar generation</span></div><div class="energy-time" data-energy-time>12:00 <small>PM</small></div><div class="energy-caption">A day at home, illustrated.</div></div>
        <div class="energy-panel"><div class="energy-tabs" role="group" aria-label="Choose a time of day"><button type="button" aria-pressed="true" data-energy-choice="day">Day</button><button type="button" aria-pressed="false" data-energy-choice="evening">Evening</button><button type="button" aria-pressed="false" data-energy-choice="night">Night</button></div><div class="energy-reading" aria-live="polite" aria-atomic="true"><span class="eyebrow" data-energy-kicker>CAPTURE + STORE</span><h3 data-energy-title>Let the roof do the work.</h3><p data-energy-copy>Your panels supply the home while the sun is up. With a compatible battery, extra solar can be stored for later.</p><div class="energy-flow"><span data-energy-from>SUN</span><span class="flow-line"></span><span data-energy-to>HOME + BATTERY</span></div></div><a href="/battery-storage/" class="line-link">Explore home batteries <Fragment set:html={arrow}/></a><p class="energy-note">Illustrative only. Operation depends on your system and utility plan. Backup duration varies with stored charge and household use.</p></div>
      </div>
    </div>
  </section>
  <section class="craft-section section"><div class="shell craft-grid"><div class="craft-photo" data-reveal><Photo name="solar-repair" alt="Illustrative close-up of gloved hands checking solar panel connections"/><span class="photo-label">THE DETAILS MAKE THE DIFFERENCE.</span></div><div class="craft-copy"><p class="eyebrow">04 / BUILT TO KEEP WORKING</p><h2 data-split>Still your home.<br />Still our kind of work.</h2><p>A blank monitoring app. A roof leak. An installer who stopped answering. You deserve a clear next step.</p><p>We diagnose solar systems other companies installed and repair the roof around them, too. One conversation can get the whole picture.</p><div class="craft-links"><a href="/solar-repair/">Solar repair <Fragment set:html={arrow}/></a><a href="/roof-repair/">Roof repair <Fragment set:html={arrow}/></a><a href="/roof-inspection/">Roof inspections <Fragment set:html={arrow}/></a></div></div></div></section>
  <section class="section process-section"><div class="shell"><div class="editorial-head"><div><p class="eyebrow">05 / FROM IDEA TO INSTALL</p><h2 data-split>Clear from the<br />first conversation.</h2></div><p>Real questions. A plan for your property.<br />A written scope before work begins.</p></div><ol class="process-track"><li data-reveal><span>01</span><h3>Tell us what’s next.</h3><p>A lower energy bill, backup power, a roof repair or an EV in the driveway. We start with you.</p></li><li data-reveal><span>02</span><h3>Look at the whole home.</h3><p>Your usage, roof and electrical setup shape the recommendation. No one-size-fits-all system.</p></li><li data-reveal><span>03</span><h3>Make an informed call.</h3><p>Review the recommended work and written price. Understand what is included before you decide.</p></li><li data-reveal><span>04</span><h3>Bring the plan to life.</h3><p>For installation projects, we handle the permits, work and inspections, plus utility paperwork where needed.</p></li></ol></div></section>
  <section class="valley-section"><div class="valley-photo" data-parallax><Photo name="fresno-street" alt="Illustrative Central Valley neighborhood in warm evening light" sizes="100vw"/></div><div class="valley-shade"></div><div class="shell valley-content"><p class="eyebrow">06 / HOME IS THE CENTRAL VALLEY</p><h2 data-split>Local roots.<br />Valley-wide care.</h2><p>From our Fresno office to the communities around it.<br />Residential and commercial projects, close to home.</p><ul class="valley-cities">{cities.map(c=><li>{c}</li>)}</ul><a class="btn btn-light" href="/contact/">Talk to our Fresno team <Fragment set:html={arrow}/></a></div></section>
  <Faq items={faqs} title="A few things you may be wondering." />
  <QuoteSection formId="quote-home" title="Your next chapter starts at home." />
</Site>
